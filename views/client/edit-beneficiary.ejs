<!DOCTYPE html>
<html>
<head>
    <title>Edit Beneficiary</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <h1>Edit Beneficiary</h1>

    <form
        action="/client/beneficiaries/<%= beneficiary.id %>/edit"
        method="POST"
    >

        <label>Name</label>

        <input
            type="text"
            name="name"
            value="<%= beneficiary.name %>"
            required
        >

        <br><br>

        <label>Account Number</label>

        <input
            type="text"
            name="accountNumber"
            value="<%= beneficiary.accountNumber %>"
            required
        >

        <br><br>

        <button type="submit">
            Save
        </button>

    </form>

    <br>

    <a href="/client/beneficiaries">
        Cancel
    </a>

</body>
</html>