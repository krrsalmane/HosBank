<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Beneficiary — HosBank</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <div class="container">
        <div style="margin-bottom: 2rem;">
            <h1>Edit Beneficiary</h1>
            <p>Update recipient credentials and banking account number.</p>
        </div>

        <div class="card" style="max-width: 550px;">
            <form action="/client/beneficiaries/<%= beneficiary.id %>/edit" method="POST">
                <div class="form-group">
                    <label for="name">Beneficiary Full Name</label>
                    <input type="text" id="name" name="name" value="<%= beneficiary.name %>" required>
                </div>

                <div class="form-group">
                    <label for="account_number">Account Number / RIB</label>
                    <input type="text" id="account_number" name="account_number" value="<%= beneficiary.account_number %>" required>
                </div>

                <div style="display: flex; gap: 1rem; align-items: center; margin-top: 1.5rem;">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a href="/client/beneficiaries" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

</body>
</html>