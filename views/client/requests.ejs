<!DOCTYPE html>
<html>
<head>
    <title>My Requests</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <h1>My Banking Requests</h1>

    <h2>New Request</h2>

    <form action="/client/requests" method="POST">

        <label>Request Type</label>

        <select name="type" required>

            <option value="">Select request</option>

            <option value="RIB">
                RIB
            </option>

            <option value="SAVINGS_ACCOUNT">
                Savings Account
            </option>

            <option value="VIRTUAL_CARD">
                Virtual Card
            </option>

            <option value="PIN_RECALCULATION">
                PIN Recalculation
            </option>

            <option value="CARD_OPPOSITION">
                Card Opposition
            </option>

        </select>

        <br><br>

        <label>Description</label>

        <br>

        <textarea
            name="description"
            rows="5"
            cols="40"
        ></textarea>

        <br><br>

        <button type="submit">
            Submit Request
        </button>

    </form>

    <hr>

    <h2>My Requests</h2>

    <% if (!requests || requests.length === 0) { %>

        <p>You don't have any requests.</p>

    <% } else { %>

        <% requests.forEach(request => { %>

            <div>

                <h3>
                    <%= request.type %>
                </h3>

                <p>
                    Status:
                    <strong>
                        <%= request.status %>
                    </strong>
                </p>

                <p>
                    <%= request.description || 'No description' %>
                </p>

                <a href="/client/requests/<%= request.id %>">
                    View details
                </a>

            </div>

            <hr>

        <% }) %>

    <% } %>

</body>
</html>