<!DOCTYPE html>
<html>
<head>
    <title>My Complaints</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <h1>My Complaints</h1>

    <h2>New Complaint</h2>

    <form action="/client/complaints" method="POST">

        <label>
            Subject
        </label>

        <br>

        <input
            type="text"
            name="subject"
            maxlength="255"
            required
        >

        <br><br>

        <label>
            Description
        </label>

        <br>

        <textarea
            name="description"
            rows="6"
            required
        ></textarea>

        <br><br>

        <button type="submit">
            Submit Complaint
        </button>

    </form>

    <hr>

    <h2>My Complaints</h2>

    <% if (complaints.length === 0) { %>

        <p>You don't have any complaints.</p>

    <% } else { %>

        <% complaints.forEach(complaint => { %>

            <div>

                <h3>
                    <%= complaint.subject %>
                </h3>

                <p>
                    Status:
                    <strong>
                        <%= complaint.status %>
                    </strong>
                </p>

                <p>
                    <%= complaint.description %>
                </p>

                <a href="/client/complaints/<%= complaint.id %>">
                    View details
                </a>

            </div>

            <hr>

        <% }) %>

    <% } %>

</body>
</html>