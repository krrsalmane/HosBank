<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PIN Recalculation — HosBank</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <div class="container">
        <div style="margin-bottom: 2rem;">
            <h1>Request PIN Recalculation</h1>
            <p>Request a new security PIN dispatch for your active bank card.</p>
        </div>

        <div class="card" style="max-width: 550px;">
            <form action="/client/cards/pin-request" method="POST">
                <div class="form-group">
                    <label for="description">Reason for PIN Request</label>
                    <textarea name="description" id="description" rows="4" placeholder="e.g., Forgotten PIN, unreadable PIN letter..." required></textarea>
                </div>

                <div style="display: flex; gap: 1rem; align-items: center; margin-top: 1.5rem;">
                    <button type="submit" class="btn btn-primary">Submit PIN Request</button>
                    <a href="/client/cards" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

</body>
</html>