<!DOCTYPE html>
<html>
<head>
    <title>PIN Recalculation</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <h1>PIN Recalculation</h1>

    <p>
        Request a new PIN for your card.
    </p>

    <form action="/client/cards/pin-request" method="POST">

        <label>
            Reason
        </label>

        <br>

        <textarea
            name="description"
            rows="5"
            required
        ></textarea>

        <br><br>

        <button type="submit">
            Request PIN Recalculation
        </button>

    </form>

</body>
</html>