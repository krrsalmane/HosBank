<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Complaint Ticket — HosBank</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <div class="container">
        <div style="margin-bottom: 1.5rem;">
            <a href="/client/complaints" style="display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 1rem;">
                ← Back to complaints
            </a>
            <h1>Ticket: <%= complaint.subject %></h1>
        </div>

        <div class="card" style="max-width: 600px;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-light); padding-bottom: 1rem; margin-bottom: 1rem;">
                <span style="color: var(--text-muted);">Ticket Status</span>
                <span class="status-badge <%= complaint.status === 'RESOLVED' ? 'badge-success' : (complaint.status === 'REJECTED' ? 'badge-danger' : 'badge-pending') %>">
                    <%= complaint.status %>
                </span>
            </div>

            <div style="border-bottom: 1px solid var(--border-light); padding-bottom: 1rem; margin-bottom: 1rem;">
                <span style="color: var(--text-muted); display: block; margin-bottom: 0.5rem;">Original Statement</span>
                <div style="background: var(--surface-muted); padding: 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--border-light); font-size: 0.95rem;">
                    <%= complaint.description %>
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; font-size: 0.85rem; color: var(--text-muted);">
                <span>Opened:</span>
                <span><%= complaint.created_at ? new Date(complaint.created_at).toLocaleString() : 'N/A' %></span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: var(--text-muted);">
                <span>Last Updated:</span>
                <span><%= complaint.updated_at ? new Date(complaint.updated_at).toLocaleString() : 'N/A' %></span>
            </div>
        </div>
    </div>

</body>
</html>