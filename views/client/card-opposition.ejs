<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Card Opposition — HosBank</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <div class="container">
        <div style="margin-bottom: 2rem;">
            <h1 style="color: var(--danger-red);">Emergency Card Opposition</h1>
            <p>If your payment card has been lost, stolen, or shows unauthorized transactions, immediately trigger opposition below.</p>
        </div>

        <div class="card" style="max-width: 600px; border-top: 4px solid var(--danger-red);">
            <form action="/client/cards/opposition" method="POST">
                <div class="form-group">
                    <label for="cardId">Select Card to Block</label>
                    <select name="cardId" id="cardId" required>
                        <option value="">Select a card</option>
                        <% cards.forEach(card => { %>
                            <option value="<%= card.id %>">
                                <%= card.type %> — •••• <%= card.card_number.slice(-4) %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="description">Reason for Opposition (Stolen, Lost, Fraud)</label>
                    <textarea name="description" id="description" rows="4" placeholder="Describe the incident (date, location, reason)..." required></textarea>
                </div>

                <div style="display: flex; gap: 1rem; align-items: center; margin-top: 1.5rem;">
                    <button type="submit" class="btn btn-danger">
                        Confirm & Block Card Immediately
                    </button>
                    <a href="/client/cards" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

</body>
</html>