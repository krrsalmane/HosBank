<!DOCTYPE html>
<html>
<head>
    <title>Add Beneficiary</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <h1>Add Beneficiary</h1>

    <form action="/client/beneficiaries/add" method="POST">

        <label>Name</label>
        <input
            type="text"
            name="name"
            required
        >

        <br><br>

        <label>Account Number</label>
        <input
            type="text"
            name="accountNumber"
            required
        >

        <br><br>

        <button type="submit">
            Add Beneficiary
        </button>

    </form>

    <br>

    <a href="/client/beneficiaries">
        Back
    </a>

</body>
</html>