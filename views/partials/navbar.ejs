<nav class="bank-nav">
    <div class="bank-nav-container">

        <a class="navbar-brand" href="/dashboard">
            HosBank <span class="logo-badge"><%= (typeof user !== 'undefined' && user && user.role) ? user.role.replace('_', ' ') : 'ONLINE' %></span>
        </a>

        <div class="navbar-nav">

            <!-- CLIENT NAVIGATION -->
            <% if (typeof user !== 'undefined' && user && user.role === 'CLIENT') { %>
                <a class="nav-link" href="/client/dashboard">Dashboard</a>
                <a class="nav-link" href="/client/accounts">Accounts</a>
                <a class="nav-link" href="/client/transfers">Transfers</a>
                <a class="nav-link" href="/client/transfers/history">History</a>
                <a class="nav-link" href="/client/beneficiaries">Beneficiaries</a>
                <a class="nav-link" href="/client/cards">Cards</a>
                <a class="nav-link" href="/client/requests">Requests</a>
                <a class="nav-link" href="/client/complaints">Complaints</a>
            <% } %>

            <!-- MANAGER / CHARGE CLIENT NAVIGATION -->
            <% if (typeof user !== 'undefined' && user && user.role === 'CHARGE_CLIENT') { %>
                <a class="nav-link" href="/manager/dashboard">Dashboard</a>
                <a class="nav-link" href="/manager/clients">Clients</a>
                <a class="nav-link" href="/manager/requests">Requests</a>
                <a class="nav-link" href="/manager/complaints">Complaints</a>
            <% } %>

            <!-- ADMIN NAVIGATION -->
            <% if (typeof user !== 'undefined' && user && user.role === 'ADMIN') { %>
                <a class="nav-link" href="/admin/dashboard">Dashboard</a>
                <a class="nav-link" href="/admin/users">Users</a>
                <a class="nav-link" href="/admin/assignments">Assignments</a>
                <a class="nav-link" href="/admin/accounts">Accounts</a>
                <a class="nav-link" href="/admin/cards">Cards</a>
                <a class="nav-link" href="/admin/transfers">Transfers</a>
                <a class="nav-link" href="/admin/requests">Requests</a>
                <a class="nav-link" href="/admin/complaints">Complaints</a>
            <% } %>

        </div>

        <!-- USER IDENTITY + LOGOUT -->
        <% if (typeof user !== 'undefined' && user) { %>
            <div class="navbar-user">
                <span class="user-badge">
                    <span><%= user.firstName || user.first_name || 'User' %></span>
                    <span class="role-tag"><%= user.role %></span>
                </span>

                <form action="/auth/logout" method="POST" style="margin: 0;">
                    <button type="submit" class="btn btn-danger btn-sm">
                        Logout
                    </button>
                </form>
            </div>
        <% } %>

    </div>
</nav>