<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Client Accounts — HosBank</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <div class="container">
        <div style="margin-bottom: 1.5rem;">
            <a href="/manager/clients/<%= clientId %>" style="display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 1rem;">
                ← Back to client profile
            </a>
            <h1>Client Bank Accounts</h1>
        </div>

        <% if (!accounts || accounts.length === 0) { %>
            <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
                <p style="color: var(--text-muted); margin: 0;">No active bank accounts found for this client.</p>
            </div>
        <% } else { %>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
                <% accounts.forEach(account => { %>
                    <div class="account-card-visual">
                        <div class="account-card-header">
                            <span class="account-card-type"><%= account.type %></span>
                            <span class="status-badge <%= account.status === 'ACTIVE' ? 'badge-active' : 'badge-pending' %>">
                                <%= account.status %>
                            </span>
                        </div>
                        <div class="account-card-number">
                            <%= account.account_number %>
                        </div>
                        <div style="margin-top: 1rem;">
                            <span style="font-size: 0.8rem; color: #94a3b8; text-transform: uppercase;">Ledger Balance</span>
                            <div class="account-card-balance">
                                <%= Number(account.balance || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
                            </div>
                        </div>
                        <div style="margin-top: 1rem; font-size: 0.85rem; color: #94a3b8;">
                            Opened: <%= account.created_at ? new Date(account.created_at).toLocaleDateString() : 'N/A' %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

</body>
</html>
