<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Complaints Management — HosBank</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <div class="container">
        <div style="margin-bottom: 2rem;">
            <h1>Client Support Complaints</h1>
            <p>Review customer grievances, open investigations, and submit formal resolution notes.</p>
        </div>

        <% if (!complaints || complaints.length === 0) { %>
            <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
                <p style="color: var(--text-muted); margin: 0;">No active complaints in your assigned queue.</p>
            </div>
        <% } else { %>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Subject</th>
                        <th>Client</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% complaints.forEach(complaint => { %>
                        <tr>
                            <td>#<%= complaint.id %></td>
                            <td>
                                <strong><%= complaint.subject %></strong>
                            </td>
                            <td>
                                <div><%= complaint.first_name %> <%= complaint.last_name %></div>
                                <small style="color: var(--text-muted);"><%= complaint.email %></small>
                            </td>
                            <td>
                                <span class="status-badge <%= complaint.status === 'RESOLVED' ? 'badge-success' : (complaint.status === 'CLOSED' ? 'badge-pending' : 'badge-danger') %>">
                                    <%= complaint.status %>
                                </span>
                            </td>
                            <td style="color: var(--text-muted); font-size: 0.85rem;">
                                <%= complaint.created_at ? new Date(complaint.created_at).toLocaleDateString() : '-' %>
                            </td>
                            <td>
                                <a href="/manager/complaints/<%= complaint.id %>" class="btn btn-secondary btn-sm">
                                    Manage Ticket
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>

</body>
</html>
