<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Banking Requests Management — HosBank</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <div class="container">
        <div style="margin-bottom: 2rem;">
            <h1>Client Banking Requests</h1>
            <p>Manage and process administrative requests submitted by your clients.</p>
        </div>

        <% if (!requests || requests.length === 0) { %>
            <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
                <p style="color: var(--text-muted); margin: 0;">No pending requests assigned to your queue.</p>
            </div>
        <% } else { %>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Type</th>
                        <th>Client</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% requests.forEach(request => { %>
                        <tr>
                            <td>#<%= request.id %></td>
                            <td>
                                <strong><%= request.type.replace('_', ' ') %></strong>
                            </td>
                            <td>
                                <div><%= request.first_name %> <%= request.last_name %></div>
                                <small style="color: var(--text-muted);"><%= request.email %></small>
                            </td>
                            <td style="max-width: 250px; font-size: 0.85rem;">
                                <%= request.description || 'No description' %>
                            </td>
                            <td>
                                <span class="status-badge <%= request.status === 'APPROVED' || request.status === 'COMPLETED' ? 'badge-success' : (request.status === 'REJECTED' ? 'badge-danger' : 'badge-pending') %>">
                                    <%= request.status %>
                                </span>
                            </td>
                            <td style="color: var(--text-muted); font-size: 0.85rem;">
                                <%= request.created_at ? new Date(request.created_at).toLocaleDateString() : '-' %>
                            </td>
                            <td>
                                <a href="/manager/requests/<%= request.id %>" class="btn btn-secondary btn-sm">
                                    Review
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>

</body>
</html>