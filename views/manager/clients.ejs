<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assigned Clients — HosBank</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <div class="container">
        <div style="margin-bottom: 2rem;">
            <h1>Assigned Client Portfolio</h1>
            <p>List of customers managed under your account representative assignment.</p>
        </div>

        <% if (!clients || clients.length === 0) { %>
            <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
                <p style="color: var(--text-muted); margin: 0;">No clients currently assigned to your portfolio.</p>
            </div>
        <% } else { %>
            <table>
                <thead>
                    <tr>
                        <th>Client Name</th>
                        <th>Email Address</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% clients.forEach(client => { %>
                        <tr>
                            <td>
                                <strong><%= client.first_name %> <%= client.last_name %></strong>
                            </td>
                            <td><%= client.email %></td>
                            <td><%= client.phone || '-' %></td>
                            <td>
                                <span class="status-badge <%= client.active ? 'badge-active' : 'badge-danger' %>">
                                    <%= client.active ? 'ACTIVE' : 'INACTIVE' %>
                                </span>
                            </td>
                            <td>
                                <a href="/manager/clients/<%= client.id %>" class="btn btn-secondary btn-sm">
                                    View Dossier
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>

</body>
</html>
