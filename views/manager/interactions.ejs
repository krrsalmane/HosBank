<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interaction History — HosBank</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <div class="container">
        <div style="margin-bottom: 1.5rem;">
            <a href="/manager/clients/<%= clientId %>" style="display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 1rem;">
                ← Back to client profile
            </a>
            <h1>Client Interaction History</h1>
        </div>

        <% if (!interactions || interactions.length === 0) { %>
            <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
                <p style="color: var(--text-muted); margin: 0;">No logged interactions or CRM notes on record.</p>
            </div>
        <% } else { %>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <% interactions.forEach(interaction => { %>
                    <div class="card" style="margin-bottom: 0;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <strong><%= interaction.type %></strong>
                            <small style="color: var(--text-muted);"><%= interaction.created_at ? new Date(interaction.created_at).toLocaleString() : '' %></small>
                        </div>
                        <p style="color: var(--text-main); margin-bottom: 0.5rem;"><%= interaction.description || 'No description provided' %></p>
                        <small style="color: var(--text-muted);">Handled by: <%= interaction.first_name %> <%= interaction.last_name %></small>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

</body>
</html>