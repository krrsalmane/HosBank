<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Request Processing — HosBank</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <div class="container">
        <div style="margin-bottom: 1.5rem;">
            <a href="/manager/requests" style="display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 1rem;">
                ← Back to requests
            </a>
            <h1>Process Request #<%= request.id %></h1>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
            <div class="card" style="margin-bottom: 0;">
                <h3 style="border-bottom: 1px solid var(--border-light); padding-bottom: 0.5rem; margin-bottom: 1rem;">Request Information</h3>

                <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem;">
                    <span style="color: var(--text-muted);">Client:</span>
                    <strong><%= request.first_name %> <%= request.last_name %></strong>
                </div>

                <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem;">
                    <span style="color: var(--text-muted);">Email:</span>
                    <span><%= request.email %></span>
                </div>

                <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem;">
                    <span style="color: var(--text-muted);">Request Type:</span>
                    <strong><%= request.type.replace('_', ' ') %></strong>
                </div>

                <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem;">
                    <span style="color: var(--text-muted);">Current Status:</span>
                    <span class="status-badge <%= request.status === 'APPROVED' || request.status === 'COMPLETED' ? 'badge-success' : (request.status === 'REJECTED' ? 'badge-danger' : 'badge-pending') %>">
                        <%= request.status %>
                    </span>
                </div>

                <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--border-light);">
                    <span style="color: var(--text-muted); display: block; margin-bottom: 0.35rem;">Client Description:</span>
                    <div style="background: var(--surface-muted); padding: 0.75rem; border-radius: var(--radius-sm); font-size: 0.9rem;">
                        <%= request.description || 'No description provided.' %>
                    </div>
                </div>
            </div>

            <div class="card" style="margin-bottom: 0;">
                <h3 style="border-bottom: 1px solid var(--border-light); padding-bottom: 0.5rem; margin-bottom: 1rem;">Update Status</h3>

                <form action="/manager/requests/<%= request.id %>/status" method="POST">
                    <div class="form-group">
                        <label for="status">Change Request State</label>
                        <select name="status" id="status" required>
                            <option value="PENDING" <%= request.status === 'PENDING' ? 'selected' : '' %>>Pending Review</option>
                            <option value="IN_PROGRESS" <%= request.status === 'IN_PROGRESS' ? 'selected' : '' %>>In Progress</option>
                            <option value="APPROVED" <%= request.status === 'APPROVED' ? 'selected' : '' %>>Approved</option>
                            <option value="REJECTED" <%= request.status === 'REJECTED' ? 'selected' : '' %>>Rejected</option>
                            <option value="COMPLETED" <%= request.status === 'COMPLETED' ? 'selected' : '' %>>Completed</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%;">
                        Save Status
                    </button>
                </form>
            </div>
        </div>

        <div class="card">
            <h2>Discussion & Responses</h2>

            <% if (!comments || comments.length === 0) { %>
                <p style="color: var(--text-muted);">No responses logged on this request yet.</p>
            <% } else { %>
                <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
                    <% comments.forEach(comment => { %>
                        <div style="background: var(--surface-muted); border: 1px solid var(--border-light); padding: 1rem; border-radius: var(--radius-sm);">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                <strong><%= comment.first_name %> <%= comment.last_name %></strong>
                                <small style="color: var(--text-muted);"><%= comment.created_at ? new Date(comment.created_at).toLocaleString() : '' %></small>
                            </div>
                            <p style="margin: 0; color: var(--text-main);"><%= comment.content %></p>
                        </div>
                    <% }) %>
                </div>
            <% } %>

            <form action="/manager/requests/<%= request.id %>/comments" method="POST" style="margin-top: 1.5rem; margin-bottom: 0;">
                <div class="form-group">
                    <label for="content">Add Internal Note or Client Response</label>
                    <textarea name="content" id="content" rows="3" placeholder="Write response message..." required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Post Message</button>
            </form>
        </div>
    </div>

</body>
</html>