<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Check Email — HosBank</title>
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>

    <div class="container">
        <div class="form-box" style="text-align: center;">
            <div style="font-size: 2.5rem; margin-bottom: 1rem;">✉️</div>
            <h1>HosBank</h1>
            <h2>Check Your Email</h2>

            <p class="description" style="margin-top: 1rem; margin-bottom: 2rem;">
                Your account registration was successful. We have dispatched a verification code and link to your email address. Please follow the instructions to activate your access.
            </p>

            <a href="/auth/login" class="btn btn-primary" style="display: block; width: 100%; text-decoration: none; padding: 0.8rem; background: #0f172a; color: white; border-radius: 8px; font-weight: 600;">
                Return to Login
            </a>
        </div>
    </div>

</body>
</html>
