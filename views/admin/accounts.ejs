<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Bank Accounts — HosBank Admin</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <div class="container">
        <div style="margin-bottom: 2rem;">
            <h1>Bank Accounts Governance</h1>
            <p>Master ledger of all client checking and savings accounts with status controls.</p>
        </div>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Account Number</th>
                    <th>Owner</th>
                    <th>Email</th>
                    <th>Type</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th>Change Status</th>
                </tr>
            </thead>
            <tbody>
                <% accounts.forEach(account => { %>
                    <tr>
                        <td>#<%= account.id %></td>
                        <td style="font-family: monospace; font-weight: 600;"><%= account.account_number %></td>
                        <td><%= account.first_name %> <%= account.last_name %></td>
                        <td><%= account.email %></td>
                        <td><span class="status-badge badge-info"><%= account.type %></span></td>
                        <td style="font-weight: 700;"><%= Number(account.balance || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                        <td>
                            <span class="status-badge <%= account.status === 'ACTIVE' ? 'badge-active' : (account.status === 'BLOCKED' ? 'badge-danger' : 'badge-pending') %>">
                                <%= account.status %>
                            </span>
                        </td>
                        <td>
                            <form action="/admin/accounts/<%= account.id %>/status" method="POST" style="margin: 0; display: flex; gap: 0.5rem; align-items: center;">
                                <select name="status" style="max-width: 140px; padding: 0.35rem 0.5rem; font-size: 0.85rem;" required>
                                    <option value="ACTIVE" <%= account.status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
                                    <option value="BLOCKED" <%= account.status === 'BLOCKED' ? 'selected' : '' %>>Blocked</option>
                                    <option value="CLOSED" <%= account.status === 'CLOSED' ? 'selected' : '' %>>Closed</option>
                                </select>
                                <button type="submit" class="btn btn-secondary btn-sm">Save</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</body>
</html>