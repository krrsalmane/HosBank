<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Transaction Audit Ledger — HosBank Admin</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <div class="container">
        <div style="margin-bottom: 2rem;">
            <h1>Global Transactions Ledger</h1>
            <p>System-wide transactional record across all accounts and transaction classifications.</p>
        </div>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Client Name</th>
                    <th>Account Number</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Description</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody>
                <% transactions.forEach(transaction => { %>
                    <tr>
                        <td>#<%= transaction.id %></td>
                        <td><strong><%= transaction.first_name %> <%= transaction.last_name %></strong></td>
                        <td style="font-family: monospace;"><%= transaction.account_number %></td>
                        <td>
                            <span class="status-badge <%= transaction.type === 'CREDIT' || transaction.type === 'DEPOSIT' ? 'badge-success' : 'badge-danger' %>">
                                <%= transaction.type %>
                            </span>
                        </td>
                        <td style="font-weight: 700; color: <%= transaction.type === 'CREDIT' || transaction.type === 'DEPOSIT' ? 'var(--success-green)' : 'var(--bank-navy-900)' %>;">
                            <%= transaction.type === 'CREDIT' || transaction.type === 'DEPOSIT' ? '+' : '-' %><%= Number(transaction.amount || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
                        </td>
                        <td><%= transaction.description || '-' %></td>
                        <td style="color: var(--text-muted); font-size: 0.85rem;">
                            <%= transaction.created_at ? new Date(transaction.created_at).toLocaleString() : '-' %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</body>
</html>