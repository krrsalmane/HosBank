<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Transfers Audit — HosBank Admin</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <div class="container">
        <div style="margin-bottom: 2rem;">
            <h1>Money Transfers Audit Log</h1>
            <p>Immutable record of all wire and inter-account funds transfers.</p>
        </div>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Sender</th>
                    <th>Sender Account</th>
                    <th>Beneficiary</th>
                    <th>Beneficiary Account</th>
                    <th>Amount</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                <% transfers.forEach(transfer => { %>
                    <tr>
                        <td>#<%= transfer.id %></td>
                        <td><strong><%= transfer.first_name %> <%= transfer.last_name %></strong></td>
                        <td style="font-family: monospace;"><%= transfer.sender_account %></td>
                        <td><%= transfer.beneficiary_name %></td>
                        <td style="font-family: monospace;"><%= transfer.beneficiary_account %></td>
                        <td style="font-weight: 700; color: var(--bank-blue-600);"><%= Number(transfer.amount || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                        <td><%= transfer.description || '-' %></td>
                        <td>
                            <span class="status-badge <%= transfer.status === 'COMPLETED' || transfer.status === 'SUCCESS' ? 'badge-success' : 'badge-pending' %>">
                                <%= transfer.status %>
                            </span>
                        </td>
                        <td style="color: var(--text-muted); font-size: 0.85rem;">
                            <%= transfer.created_at ? new Date(transfer.created_at).toLocaleString() : '-' %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</body>
</html>