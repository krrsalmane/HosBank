<!DOCTYPE html>
<html>

<head>
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <h1>Admin Dashboard</h1>

    <p>
        Welcome
        <%= user.firstName %>
        <%= user.lastName %>
    </p>

    <div>
        <h2>Statistics</h2>

        <p>
            <strong>Total Users:</strong>
            <%= stats.users %>
        </p>

        <p>
            <strong>Clients:</strong>
            <%= stats.clients %>
        </p>

        <p>
            <strong>Chargés Client:</strong>
            <%= stats.managers %>
        </p>

        <p>
            <strong>Bank Accounts:</strong>
            <%= stats.accounts %>
        </p>

        <p>
            <strong>Pending Requests:</strong>
            <%= stats.requests %>
        </p>

        <p>
            <strong>Open Complaints:</strong>
            <%= stats.complaints %>
        </p>
    </div>

    <br>

    <div>
        <h2>Administration</h2>

        <p>
            <a href="/admin/users">
                Manage Users
            </a>
        </p>

        <p>
            <a href="/admin/accounts">
                Manage Accounts
            </a>
        </p>

        <p>
            <a href="/admin/cards">
                Manage Cards
            </a>
        </p>

        <p>
            <a href="/admin/requests">
                View Banking Requests
            </a>
        </p>

        <p>
            <a href="/admin/complaints">
                View Complaints
            </a>
        </p>

        <p>
            <a href="/admin/transfers">
                View Transfers
            </a>
        </p>
    </div>

</body>

</html>