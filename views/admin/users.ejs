<!DOCTYPE html>
<html>

<head>
    <title>Manage Users</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <h1>Manage Users</h1>

    <p>
        <a href="/admin/dashboard">
            Back to Admin Dashboard
        </a>
    </p>

    <p>
        <a href="/admin/users/create">
            Create New User
        </a>
    </p>

    <table border="1" cellpadding="8">

        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Role</th>
                <th>Email Verified</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            <% users.forEach(accountUser => { %>

                <tr>

                    <td>
                        <%= accountUser.id %>
                    </td>

                    <td>
                        <%= accountUser.first_name %>
                        <%= accountUser.last_name %>
                    </td>

                    <td>
                        <%= accountUser.email %>
                    </td>

                    <td>
                        <%= accountUser.phone || '-' %>
                    </td>

                    <td>
                        <%= accountUser.role %>
                    </td>

                    <td>
                        <%= accountUser.email_verified ? 'Yes' : 'No' %>
                    </td>

                    <td>
                        <%= accountUser.active ? 'Active' : 'Inactive' %>
                    </td>

                    <td>

                        <a href="/admin/users/<%= accountUser.id %>/edit">
                            Edit
                        </a>

                        <br><br>

                        <form
                            action="/admin/users/<%= accountUser.id %>/status"
                            method="POST"
                        >

                            <input
                                type="hidden"
                                name="active"
                                value="<%= accountUser.active ? 'false' : 'true' %>"
                            >

                            <button type="submit">

                                <%= accountUser.active
                                    ? 'Deactivate'
                                    : 'Activate'
                                %>

                            </button>

                        </form>

                    </td>

                </tr>

            <% }) %>

        </tbody>

    </table>

</body>

</html>