<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Users — HosBank Admin</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', { user: user }) %>

    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
            <div>
                <h1>User Management</h1>
                <p>Complete directory of registered clients, managers, and system administrators.</p>
            </div>
            <a href="/admin/users/create" class="btn btn-primary">
                + Create New User
            </a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>User</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Role</th>
                    <th>Verified</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(accountUser => { %>
                    <tr>
                        <td>#<%= accountUser.id %></td>
                        <td>
                            <strong><%= accountUser.first_name %> <%= accountUser.last_name %></strong>
                        </td>
                        <td><%= accountUser.email %></td>
                        <td><%= accountUser.phone || '-' %></td>
                        <td>
                            <span class="status-badge" style="background: var(--surface-muted); color: var(--bank-navy-800); border: 1px solid var(--border-light);">
                                <%= accountUser.role %>
                            </span>
                        </td>
                        <td>
                            <span class="status-badge <%= accountUser.email_verified ? 'badge-success' : 'badge-warning' %>">
                                <%= accountUser.email_verified ? 'VERIFIED' : 'PENDING' %>
                            </span>
                        </td>
                        <td>
                            <span class="status-badge <%= accountUser.active ? 'badge-active' : 'badge-danger' %>">
                                <%= accountUser.active ? 'ACTIVE' : 'INACTIVE' %>
                            </span>
                        </td>
                        <td>
                            <div style="display: flex; gap: 0.5rem; align-items: center;">
                                <a href="/admin/users/<%= accountUser.id %>/edit" class="btn btn-secondary btn-sm">
                                    Edit
                                </a>

                                <form action="/admin/users/<%= accountUser.id %>/status" method="POST" style="margin: 0; display: inline;">
                                    <input type="hidden" name="active" value="<%= accountUser.active ? 'false' : 'true' %>">
                                    <button type="submit" class="btn <%= accountUser.active ? 'btn-danger' : 'btn-primary' %> btn-sm">
                                        <%= accountUser.active ? 'Deactivate' : 'Activate' %>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</body>
</html>